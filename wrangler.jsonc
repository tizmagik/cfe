{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cfe",
  "main": "worker.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "christforeveryone.org",
      "custom_domain": true
    },
    {
      "pattern": "www.christforeveryone.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "DEPLOYMENT_SHA": "local"
  }
}
